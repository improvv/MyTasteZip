<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_home">

    <fragment
        android:id="@+id/nav_home"
        android:name="com.example.mytastezip.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/nav_community"
        android:name="com.example.mytastezip.ui.community.CommunityFragment"
        android:label="Community"
        tools:layout="@layout/fragment_community" />

    <fragment
        android:id="@+id/nav_add"
        android:name="com.example.mytastezip.ui.add.AddFragment"
        android:label="Add"
        tools:layout="@layout/fragment_add" >
        <argument
            android:name="shared_link"
            app:argType="string"
            android:defaultValue="" />
    </fragment>

    <fragment
        android:id="@+id/nav_list"
        android:name="com.example.mytastezip.ui.savedList.SavedListFragment"
        android:label="SavedList"
        tools:layout="@layout/fragment_saved_list" />


</navigation>